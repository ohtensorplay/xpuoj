{
  "name": "xpuoj-plugin-workspace",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/xpuoj"
  ],
  "scripts": {
    "build": "npm run build --workspace @tensorplay/xpuoj",
    "check": "npm run typecheck --workspace @tensorplay/xpuoj && npm run build --workspace @tensorplay/xpuoj && npm run check:public",
    "check:public": "node scripts/check-public-surface.mjs",
    "test": "npm run test --workspace @tensorplay/xpuoj",
    "pack:cli": "npm pack --workspace @tensorplay/xpuoj"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
