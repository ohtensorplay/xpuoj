{
  "name": "@tensorplay/xpuoj",
  "version": "0.3.3",
  "description": "Local direct XPUOJ MCP client",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ohtensorplay/xpuoj.git"
  },
  "homepage": "https://github.com/ohtensorplay/xpuoj#readme",
  "bugs": {
    "url": "https://github.com/ohtensorplay/xpuoj/issues"
  },
  "type": "module",
  "bin": {
    "xpuoj": "dist/cli.js"
  },
  "exports": {
    ".": "./dist/core.js",
    "./core": "./dist/core.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "npm run typecheck && npm run build && npm run check:public",
    "check:public": "node scripts/check-public-surface.mjs",
    "test": "npm run build && node --test test/*.test.mjs",
    "pack:cli": "npm pack",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "keywords": [
    "xpuoj",
    "online-judge",
    "mcp",
    "cli",
    "gpu"
  ]
}
